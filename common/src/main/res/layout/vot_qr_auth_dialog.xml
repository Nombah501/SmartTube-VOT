<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_qr_image"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/vot_qr_title"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_qr_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:textColor="@color/dialog_text_color"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_qr_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/vot_qr_scan_hint"
        android:textColor="@color/dialog_text_color"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_qr_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/dialog_text_color"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_qr_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/dialog_text_color"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_qr_url_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/vot_qr_url_note"
        android:textColor="@color/dialog_text_color"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_qr_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/vot_qr_refresh" />

        <Button
            android:id="@+id/btn_qr_manual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/vot_qr_manual" />

        <Button
            android:id="@+id/btn_qr_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/vot_qr_cancel" />
    </LinearLayout>
</LinearLayout>
